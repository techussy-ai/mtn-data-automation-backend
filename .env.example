# Copy to .env — NEVER commit .env. No real secrets belong in this file.
NODE_ENV=development
PORT=8080

# simulation is the default. "live" is refused at startup in Stage 1.
APP_MODE=simulation

# Supabase Postgres (server-side only). Use the pooled/direct connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mtn_automation
# Server-side only. Never expose to the dashboard/browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Redis for BullMQ
REDIS_URL=redis://localhost:6379

# Secrets: generate with `openssl rand -hex 32`
ADMIN_JWT_SECRET=change-me-min-32-chars-change-me-min-32
WEBHOOK_SIGNING_SECRET=change-me-min-32-chars-change-me-min-32
API_TIMESTAMP_TOLERANCE_SECONDS=300

# Queue limits (tune only after real gateway testing)
QUEUE_GLOBAL_CONCURRENCY=4
QUEUE_CHANNEL_A_CONCURRENCY=1
QUEUE_CHANNEL_B_CONCURRENCY=4
